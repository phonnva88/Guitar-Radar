# Keep shell, Python and build files usable from WSL even when Git on Windows
# has core.autocrlf enabled globally.
* text=auto eol=lf
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf
# Preserve pinned browser asset/license bytes so manifest checksums stay valid.
radar/static/vendor/** -text -whitespace
